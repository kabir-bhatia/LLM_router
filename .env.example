# ============================================
# Smart Model Router - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ===================
# Database (SQLite)
# ===================
# Single local file, no server to run. Tables are created on startup.
DATABASE_URL=sqlite+aiosqlite:///./router.db

# ===================
# Google Gemini -- Vertex AI (service account), recommended
# ===================
# Get a service account key: GCP Console -> IAM & Admin -> Service Accounts
# -> your account -> Keys -> Add Key -> JSON. Grant it the "Vertex AI User"
# role. Never commit the downloaded JSON file (see .gitignore).
#
# Recommended over the API key below: on the project this was built against,
# the API key path throttled the newest Gemini model generation to a 15
# req/min free-tier limit even with paid tier enabled, and 404'd on
# gemini-2.5-pro as deprecated for new users. Vertex AI with a service
# account had neither problem (confirmed with concurrent-burst tests).
USE_VERTEX_AI=true
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account-key.json
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global

# ===================
# Google Gemini -- AI Studio API key (fallback, USE_VERTEX_AI=false)
# ===================
# Get your API key from: https://aistudio.google.com/apikey
# Lower setup cost (no GCP project/service account needed), but see the
# rate-limit caveat above -- results may vary by account/project.
GOOGLE_API_KEY=your-gemini-api-key-here

# Model per difficulty tier. All three are Gemini, so there is a single
# provider and auth path, with a ~1.7x input / ~2.7x output price spread
# between the cheapest and most expensive tier. GA (non-preview) models only.
TIER_SIMPLE_MODEL=gemini-3.1-flash-lite
TIER_MEDIUM_MODEL=gemini-3.6-flash
TIER_COMPLEX_MODEL=gemini-2.5-pro

# The classifier runs on EVERY request, so it must be cheap.
CLASSIFIER_MODEL=gemini-3.1-flash-lite

# ===================
# Embeddings (local, no API key needed)
# ===================
# Runs on CPU via sentence-transformers. Downloaded once (~80MB) on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ===================
# Redis Cache (optional)
# ===================
# The semantic cache needs the RediSearch module (Redis Stack), NOT plain
# Redis -- it uses FT.CREATE/FT.SEARCH for vector similarity. Left off by
# default; when off, or if Redis is unreachable, the router serves uncached
# rather than failing.
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Cosine similarity above which a stored prompt counts as a cache hit.
# The upstream project hardcoded 0.92 with no validation behind it.
# See eval/threshold_sweep.py for the measurement.
SEMANTIC_SIMILARITY_THRESHOLD=0.92

# ===================
# API Security
# ===================
API_KEY_HEADER=X-API-Key

# ===================
# Routing Configuration
# ===================
# Token thresholds used by the rule-based classifier
SIMPLE_TOKEN_THRESHOLD=50
COMPLEX_TOKEN_THRESHOLD=500

# true  = LLM-based classification (a cheap model grades each prompt)
# false = rule-based heuristics only
# Phase 3 measures the accuracy of both.
USE_LLM_ROUTER=true
USE_SEMANTIC_CACHE=true

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
